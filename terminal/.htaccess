<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /terminal/
# If the request is a real file/dir, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# SPA fallback
RewriteRule . /terminal/index.html [L]
</IfModule>

# Hashed build assets are immutable; HTML is always revalidated.
<IfModule mod_headers.c>
<FilesMatch "\.(js|css|map|woff2?|png|svg|webmanifest|txt)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "^(index\.html|404\.html)$">
Header set Cache-Control "no-cache, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>