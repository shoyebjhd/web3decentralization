<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /terminal/
# Real files/dirs pass through (embeds, OG images, data files) —
# except the bare shell root, which must reach WordPress (no static index).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/terminal/?$
RewriteRule ^ - [L]
# Shell root + tool pages + deep links all route to WordPress
# (no static index remains; the React bundle was retired, see git history)
RewriteRule ^(.*)$ /index.php [L]
</IfModule>

# Hashed build assets are immutable; HTML is always revalidated.
<IfModule mod_headers.c>
<FilesMatch "\.(js|css|map|woff2?|png|svg|webmanifest|txt)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "^(index\.html|404\.html)$">
Header set Cache-Control "no-cache, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>